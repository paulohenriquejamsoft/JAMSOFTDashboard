<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jamsoft.DashBoards.Coletor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <!-- O framework Windows Desktop já traz System.Security.Cryptography.Pkcs 10.x; a referência forçada
       pelo Directory.Build.props vira NU1510 (pacote podado) e quebra o build com -warnaserror. -->
  <ItemGroup>
    <PackageReference Remove="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jamsoft.DashBoards.Coletor.Nucleo\Jamsoft.DashBoards.Coletor.Nucleo.csproj" />
  </ItemGroup>

</Project>
